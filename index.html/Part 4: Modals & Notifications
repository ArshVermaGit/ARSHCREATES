<!-- ==========================================
     ENHANCED UNIFIED PORTFOLIO MODAL
     For viewing games, websites, and apps
     ========================================== -->
<div class="portfolio-modal" id="portfolioModal">
    <div class="modal-overlay"></div>
    <div class="modal-container modal-xl">
        <!-- Close Button -->
        <button class="modal-close" id="closeModal" aria-label="Close modal">
            <i class="fas fa-times"></i>
        </button>
        
        <!-- Navigation Arrows -->
        <button class="modal-nav modal-prev" id="modalPrev" aria-label="Previous item">
            <i class="fas fa-chevron-left"></i>
        </button>
        <button class="modal-nav modal-next" id="modalNext" aria-label="Next item">
            <i class="fas fa-chevron-right"></i>
        </button>

        <!-- Modal Content Grid -->
        <div class="modal-content">
            <!-- Left: Preview Area -->
            <div class="modal-preview">
                <!-- Default Item Preview -->
                <div id="itemPreview">
                    <img src="" alt="Preview" id="previewImage">
                    <button class="modal-play-btn" id="playItemBtn">
                        <i class="fas fa-play"></i>
                        <span>Play Game</span>
                    </button>
                </div>
                
                <!-- Game Container -->
                <div class="modal-game" id="gameContainer">
                    <canvas id="unity-canvas"></canvas>
                    <div class="game-loading" id="gameLoading">
                        <div class="loading-spinner"></div>
                        <p>Loading Game...</p>
                        <div class="loading-bar">
                            <div class="loading-progress" id="loadingProgress"></div>
                        </div>
                    </div>
                    <!-- Game Controls (NEW) -->
                    <div class="game-controls" id="gameControls" style="display: none;">
                        <button class="game-control-btn" id="fullscreenBtn" title="Fullscreen">
                            <i class="fas fa-expand"></i>
                        </button>
                        <button class="game-control-btn" id="muteBtn" title="Mute">
                            <i class="fas fa-volume-up"></i>
                        </button>
                        <button class="game-control-btn" id="restartBtn" title="Restart">
                            <i class="fas fa-redo"></i>
                        </button>
                    </div>
                </div>

                <!-- Website Preview (NEW - Enhanced) -->
                <div id="websitePreview">
                    <iframe id="websiteFrame" sandbox="allow-scripts allow-same-origin" 
                            style="width: 100%; height: 100%; border: none;"></iframe>
                </div>

                <!-- App Preview (NEW) -->
                <div id="appPreview">
                    <div class="app-preview-container">
                        <div class="phone-frame">
                            <div class="phone-notch"></div>
                            <div class="phone-screen">
                                <img src="" alt="App Preview" id="appPreviewImage">
                            </div>
                            <div class="phone-button"></div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Right: Info Panel -->
            <div class="modal-info">
                <!-- Header with Badges -->
                <div class="modal-header">
                    <div class="modal-badges" id="modalBadges">
                        <!-- Dynamic badges -->
                    </div>
                    <h2 class="modal-title" id="modalTitle">Title</h2>
                    <div class="modal-meta" id="modalMeta">
                        <!-- Meta info like date, category, etc. -->
                    </div>
                </div>

                <!-- Rating & Stats (NEW) -->
                <div class="modal-stats" id="modalStats">
                    <div class="stat">
                        <i class="fas fa-star"></i>
                        <span class="stat-value" id="rating">4.8</span>
                        <span class="stat-label">Rating</span>
                    </div>
                    <div class="stat">
                        <i class="fas fa-download"></i>
                        <span class="stat-value" id="downloads">10K+</span>
                        <span class="stat-label">Downloads</span>
                    </div>
                    <div class="stat">
                        <i class="fas fa-heart"></i>
                        <span class="stat-value" id="likes">2.3K</span>
                        <span class="stat-label">Likes</span>
                    </div>
                </div>

                <!-- Tabs for Description/Features/Reviews (NEW) -->
                <div class="modal-tabs">
                    <button class="modal-tab active" data-tab="description">
                        <i class="fas fa-info-circle"></i>
                        Description
                    </button>
                    <button class="modal-tab" data-tab="features">
                        <i class="fas fa-list"></i>
                        Features
                    </button>
                    <button class="modal-tab" data-tab="reviews">
                        <i class="fas fa-star"></i>
                        Reviews
                    </button>
                </div>

                <!-- Tab Content -->
                <div class="modal-tab-content">
                    <!-- Description Tab -->
                    <div class="tab-pane active" data-pane="description">
                        <p class="modal-description" id="modalDescription">Description</p>
                    </div>

                    <!-- Features Tab -->
                    <div class="tab-pane" data-pane="features">
                        <ul class="features-list" id="featuresList">
                            <!-- Dynamic features -->
                        </ul>
                    </div>

                    <!-- Reviews Tab (NEW) -->
                    <div class="tab-pane" data-pane="reviews">
                        <div class="reviews-container" id="reviewsContainer">
                            <!-- Dynamic reviews -->
                        </div>
                    </div>
                </div>

                <!-- Technologies Used -->
                <div class="modal-tech" id="modalTech">
                    <!-- Technologies tags -->
                </div>
                
                <!-- Action Buttons -->
                <div class="modal-actions" id="modalActions">
                    <!-- Dynamic action buttons -->
                </div>

                <!-- Social Share (NEW) -->
                <div class="modal-social">
                    <p class="social-label">Share this:</p>
                    <div class="social-buttons">
                        <button class="social-btn" data-share="twitter" aria-label="Share on Twitter">
                            <i class="fab fa-twitter"></i>
                        </button>
                        <button class="social-btn" data-share="facebook" aria-label="Share on Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </button>
                        <button class="social-btn" data-share="linkedin" aria-label="Share on LinkedIn">
                            <i class="fab fa-linkedin-in"></i>
                        </button>
                        <button class="social-btn" data-share="copy" aria-label="Copy link">
                            <i class="fas fa-link"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================
