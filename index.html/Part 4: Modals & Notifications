<!-- ==========================================
     QUICK CONTACT WIDGET (NEW FEATURE)
     Floating contact form
     ========================================== -->
<div class="quick-contact-widget" id="quickContactWidget">
    <button class="widget-toggle" id="widgetToggle">
        <i class="fas fa-comment-dots"></i>
        <span class="widget-badge">!</span>
    </button>

    <div class="widget-panel">
        <div class="widget-header">
            <h4>Quick Message</h4>
            <button class="widget-close">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <form class="widget-form" id="quickContactForm">
            <div class="form-group">
                <input type="text" class="form-input" placeholder="Your name" required>
            </div>
            <div class="form-group">
                <input type="email" class="form-input" placeholder="Your email" required>
            </div>
            <div class="form-group">
                <textarea class="form-textarea" placeholder="Your message..." rows="3" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-block btn-sm">
                <i class="fas fa-paper-plane"></i>
                Send Message
            </button>
        </form>
        <div class="widget-footer">
            <p class="text-muted">We typically reply within 24 hours</p>
        </div>
    </div>
</div>

