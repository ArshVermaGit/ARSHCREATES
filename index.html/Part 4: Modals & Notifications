<!-- ==========================================
     MEETING SCHEDULER MODAL (NEW FEATURE)
     For booking consultations
     ========================================== -->
<div class="modal meeting-modal" id="meetingModal">
    <div class="modal-overlay"></div>
    <div class="modal-container">
        <button class="modal-close">
            <i class="fas fa-times"></i>
        </button>

        <div class="modal-header">
            <h2>
                <i class="fas fa-calendar-check"></i>
                Schedule a Meeting
            </h2>
            <p class="text-muted">Book a free 30-minute consultation</p>
        </div>

        <div class="modal-body">
            <form class="meeting-form" id="meetingForm">
                <div class="form-group">
                    <label for="meetingName">
                        <i class="fas fa-user"></i>
                        Your Name *
                    </label>
                    <input type="text" id="meetingName" class="form-input" required>
                </div>

                <div class="form-group">
                    <label for="meetingEmail">
                        <i class="fas fa-envelope"></i>
                        Email Address *
                    </label>
                    <input type="email" id="meetingEmail" class="form-input" required>
                </div>

                <div class="form-group">
                    <label for="meetingDate">
                        <i class="fas fa-calendar"></i>
                        Preferred Date *
                    </label>
                    <input type="date" id="meetingDate" class="form-input" required>
                </div>

                <div class="form-group">
                    <label for="meetingTime">
                        <i class="fas fa-clock"></i>
                        Preferred Time *
                    </label>
                    <select id="meetingTime" class="form-select" required>
                        <option value="">Select time...</option>
                        <option value="09:00">09:00 AM</option>
                        <option value="10:00">10:00 AM</option>
                        <option value="11:00">11:00 AM</option>
                        <option value="14:00">02:00 PM</option>
                        <option value="15:00">03:00 PM</option>
                        <option value="16:00">04:00 PM</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="meetingTopic">
                        <i class="fas fa-comment"></i>
                        Meeting Topic
                    </label>
                    <textarea id="meetingTopic" class="form-textarea" rows="3" 
                              placeholder="Briefly describe what you'd like to discuss..."></textarea>
                </div>

                <button type="submit" class="btn btn-primary btn-block">
                    <i class="fas fa-calendar-plus"></i>
                    Schedule Meeting
                </button>
            </form>
        </div>
    </div>
</div>

