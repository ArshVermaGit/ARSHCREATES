     - Favorites system
     ========================================== -->
<section id="games" class="section portfolio-section active-section">
    <div class="container">
        <!-- Section Header with Controls -->
        <div class="section-header" data-aos="fade-up">
            <div class="header-content">
                <span class="section-tag">
                    <i class="fas fa-gamepad"></i>
                    Games Portfolio
                </span>
                <h2 class="section-title">Interactive Gaming Experiences</h2>
                <p class="section-description">
                    Immersive 3D worlds and engaging gameplay mechanics
                </p>
            </div>

            <!-- Section Controls (NEW FEATURE) -->
            <div class="section-controls">
                <!-- Search -->
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Search games..." id="gamesSearch">
                </div>

                <!-- View Toggle -->
                <div class="view-toggle">
                    <button class="view-btn active" data-view="grid" aria-label="Grid view">
                        <i class="fas fa-th"></i>
                    </button>
                    <button class="view-btn" data-view="list" aria-label="List view">
                        <i class="fas fa-list"></i>
                    </button>
                </div>

                <!-- Filter Dropdown -->
                <div class="filter-dropdown">
                    <button class="filter-btn">
                        <i class="fas fa-filter"></i>
                        <span>Filter</span>
                    </button>
                    <div class="filter-menu">
                        <label class="filter-option">
                            <input type="checkbox" value="unity" checked>
                            <span>Unity</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" value="unreal" checked>
                            <span>Unreal Engine</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" value="3d" checked>
                            <span>3D Games</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" value="2d" checked>
                            <span>2D Games</span>
                        </label>
                    </div>
                </div>

                <!-- Sort Dropdown -->
                <div class="sort-dropdown">
                    <button class="sort-btn">
                        <i class="fas fa-sort"></i>
                        <span>Sort By</span>
                    </button>
                    <div class="sort-menu">
                        <button data-sort="date">Latest First</button>
                        <button data-sort="name">Name A-Z</button>
                        <button data-sort="popular">Most Popular</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Filters Display (NEW) -->
        <div class="active-filters" id="gamesActiveFilters"></div>

        <!-- Portfolio Grid (Dynamic) -->
        <div class="portfolio-grid" id="gamesGrid" data-view="grid">
