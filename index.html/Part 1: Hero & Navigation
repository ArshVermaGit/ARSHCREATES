<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <!-- ============================================
         META TAGS & SEO OPTIMIZATION
         ============================================ -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <meta name="description" content="Arsh Verma - Creative Developer specializing in game development, web applications, and innovative digital solutions.">
    <meta name="keywords" content="game developer, web developer, unity, apps, creative developer, portfolio">
    <meta name="author" content="Arsh Verma">
    <meta name="robots" content="index, follow">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="Arsh Verma - Creative Developer">
    <meta property="og:description" content="Explore my portfolio of games, websites, and innovative applications.">
    <meta property="og:image" content="images/og-image.jpg">
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Arsh Verma - Creative Developer">
    <meta name="twitter:description" content="Explore my portfolio of games, websites, and innovative applications.">
    
    <title>Arsh Verma - Creative Developer | Games, Apps & Web Solutions</title>
    
    <!-- ============================================
         STYLESHEETS & ICONS
         ============================================ -->
    <link rel="stylesheet" href="css/style.css">
    <link rel="icon" href="images/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <!-- Preload critical assets -->
    <link rel="preload" href="css/style.css" as="style">
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" as="style">
</head>
<body>
    <!-- ============================================
         ACCESSIBILITY: SKIP TO CONTENT LINK
         ============================================ -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- ============================================
         LOADING SCREEN WITH PROGRESS INDICATOR
         Feature: Custom loading animation
         ============================================ -->
    <div class="loading-screen" id="loadingScreen">
        <div class="loading-content">
            <div class="loading-logo">
                <i class="fas fa-code"></i>
                <span class="loading-text">ArshCreates</span>
            </div>
            <div class="loading-bar-container">
                <div class="loading-bar" id="loadingBar"></div>
            </div>
            <p class="loading-percentage" id="loadingPercentage">0%</p>
            <p class="loading-status" id="loadingStatus">Initializing...</p>
        </div>
    </div>

    <!-- ============================================
         CURSOR TRAIL EFFECT CANVAS
         Feature: Custom animated cursor trail
         ============================================ -->
    <canvas id="cursorCanvas"></canvas>

    <!-- ============================================
         PARTICLE BACKGROUND CANVAS
         Feature: Interactive particle system
         ============================================ -->
    <canvas id="particleCanvas"></canvas>

    <!-- ============================================
         FLOATING ACTION BUTTON (FAB) MENU
         Feature: Quick access to key actions
         ============================================ -->
    <div class="fab-container" id="fabContainer">
        <button class="fab-main" id="fabMain" aria-label="Quick actions menu">
            <i class="fas fa-plus"></i>
        </button>
        <div class="fab-menu" id="fabMenu">
            <button class="fab-item" data-action="scroll-top" aria-label="Scroll to top">
                <i class="fas fa-arrow-up"></i>
                <span class="fab-tooltip">Top</span>
            </button>
            <button class="fab-item" data-action="share" aria-label="Share portfolio">
                <i class="fas fa-share-alt"></i>
                <span class="fab-tooltip">Share</span>
            </button>
            <button class="fab-item" data-action="download-cv" aria-label="Download CV">
                <i class="fas fa-file-download"></i>
                <span class="fab-tooltip">CV</span>
            </button>
            <button class="fab-item" data-action="quick-contact" aria-label="Quick contact">
                <i class="fas fa-envelope"></i>
                <span class="fab-tooltip">Contact</span>
            </button>
        </div>
    </div>

    <!-- ============================================
         QUICK NAVIGATION BAR (SIDE NAVIGATION)
         Feature: Sticky section navigator with progress
         ============================================ -->
    <div class="quick-nav" id="quickNav">
        <div class="quick-nav-items">
            <button class="quick-nav-btn active" data-section="games" aria-label="Navigate to games">
                <i class="fas fa-gamepad"></i>
                <span>Games</span>
                <div class="progress-ring">
                    <svg width="60" height="60">
                        <circle class="progress-ring-circle" stroke="var(--accent)" stroke-width="2" fill="transparent" r="28" cx="30" cy="30"/>
                    </svg>
                </div>
            </button>
            <button class="quick-nav-btn" data-section="websites" aria-label="Navigate to websites">
                <i class="fas fa-laptop-code"></i>
                <span>Websites</span>
                <div class="progress-ring">
                    <svg width="60" height="60">
                        <circle class="progress-ring-circle" stroke="var(--accent)" stroke-width="2" fill="transparent" r="28" cx="30" cy="30"/>
                    </svg>
                </div>
            </button>
            <button class="quick-nav-btn" data-section="apps" aria-label="Navigate to apps">
                <i class="fas fa-mobile-alt"></i>
                <span>Apps</span>
                <div class="progress-ring">
                    <svg width="60" height="60">
                        <circle class="progress-ring-circle" stroke="var(--accent)" stroke-width="2" fill="transparent" r="28" cx="30" cy="30"/>
                    </svg>
                </div>
            </button>
        </div>
    </div>

    <!-- ============================================
         COMMAND PALETTE / SEARCH
         Feature: Keyboard-driven quick search (Ctrl+K)
         ============================================ -->
    <div class="command-palette" id="commandPalette">
        <div class="command-palette-overlay"></div>
        <div class="command-palette-container">
            <div class="command-palette-search">
                <i class="fas fa-search"></i>
                <input type="text" id="commandInput" placeholder="Type to search... (Ctrl+K)" autocomplete="off">
                <kbd>ESC</kbd>
            </div>
            <div class="command-palette-results" id="commandResults">
                <!-- Dynamic search results -->
            </div>
            <div class="command-palette-footer">
                <span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
                <span><kbd>↵</kbd> Select</span>
                <span><kbd>ESC</kbd> Close</span>
            </div>
        </div>
    </div>

    <!-- ============================================
         NAVIGATION BAR WITH FEATURES
         - Sticky navigation with blur effect
         - Theme toggle
         - Search trigger
         - Mobile responsive menu
         ============================================ -->
    <nav class="navbar" id="navbar">
        <div class="nav-container">
            <!-- Logo with animation -->
            <a href="/" class="logo" aria-label="Home">
                <i class="fas fa-code"></i>
                <span>ArshCreates</span>
                <div class="logo-pulse"></div>
            </a>

            <!-- Desktop Navigation Menu -->
            <ul class="nav-menu" id="navMenu" role="navigation">
                <li><a href="#about" class="nav-link">About</a></li>
                <li><a href="#games" class="nav-link">Games</a></li>
                <li><a href="#websites" class="nav-link">Websites</a></li>
                <li><a href="#apps" class="nav-link">Apps</a></li>
                <li><a href="#skills" class="nav-link">Skills</a></li>
                <li><a href="#testimonials" class="nav-link">Testimonials</a></li>
                <li><a href="#contact" class="nav-link">Contact</a></li>
            </ul>

            <!-- Navigation Actions -->
            <div class="nav-actions">
                <!-- Search Button -->
                <button id="searchBtn" class="btn-icon" aria-label="Search" title="Search (Ctrl+K)">
                    <i class="fas fa-search"></i>
                </button>

                <!-- Notifications Button (NEW FEATURE) -->
                <button id="notifBtn" class="btn-icon" aria-label="Notifications">
                    <i class="fas fa-bell"></i>
                    <span class="notification-badge">3</span>
                </button>

                <!-- Theme Toggle Button -->
                <button id="themeBtn" class="btn-icon" aria-label="Toggle theme">
                    <i class="fas fa-moon"></i>
                </button>

                <!-- Language Selector (NEW FEATURE) -->
                <div class="language-selector">
                    <button class="btn-icon" id="langBtn" aria-label="Change language">
                        <i class="fas fa-globe"></i>
                    </button>
                    <div class="language-menu" id="langMenu">
                        <button data-lang="en" class="active">English</button>
                        <button data-lang="es">Español</button>
                        <button data-lang="fr">Français</button>
                        <button data-lang="hi">हिंदी</button>
                    </div>
                </div>

                <!-- Mobile Menu Toggle -->
                <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>

        <!-- Search Bar (appears when search is triggered) -->
        <div class="nav-search-expanded" id="navSearch">
            <div class="nav-search-container">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Search projects, skills, or content..." id="navSearchInput">
                <button class="search-close" id="searchClose">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
    </nav>

    <!-- ============================================
         BREADCRUMB NAVIGATION (NEW FEATURE)
         Shows current position in site hierarchy
         ============================================ -->
    <div class="breadcrumb" id="breadcrumb">
        <div class="container">
            <span class="breadcrumb-item">Home</span>
            <i class="fas fa-chevron-right"></i>
            <span class="breadcrumb-item active" id="currentSection">Portfolio</span>
        </div>
    </div>

    <!-- ============================================
         MAIN CONTENT AREA
         ============================================ -->
    <main id="main-content">
        
        <!-- ==========================================
             HERO SECTION WITH ADVANCED FEATURES
             - Animated gradient background
             - Typewriter effect
             - 3D floating elements
             - Call-to-action buttons
             - Social proof badges
             - Stats counter
             ========================================== -->
        <section class="hero" id="hero">
            <div class="hero-background">
                <!-- Animated gradient mesh -->
                <div class="gradient-mesh"></div>
                <!-- Floating shapes -->
                <div class="floating-shapes">
                    <div class="shape shape-1"></div>
                    <div class="shape shape-2"></div>
                    <div class="shape shape-3"></div>
                </div>
            </div>

            <div class="container">
                <div class="hero-grid">
                    <!-- Left Column: Text Content -->
                    <div class="hero-content">
                        <!-- Status Badge (NEW) -->
                        <div class="hero-status">
                            <span class="status-dot"></span>
                            <span class="status-text">Available for Projects</span>
                        </div>

                        <!-- Hero Tag -->
                        <span class="hero-tag">
                            <i class="fas fa-star"></i>
                            Creative Developer & Innovator
                        </span>

                        <!-- Hero Title with Gradient -->
                        <h1 class="hero-title">
                            Hi, I'm <span class="gradient-text">Arsh Verma</span>
                        </h1>

                        <!-- Typewriter Subtitle (Dynamic) -->
                        <p class="hero-subtitle">
                            <span class="typewriter" id="typewriter"></span>
                            <span class="cursor">|</span>
                        </p>

                        <!-- Hero Description -->
                        <p class="hero-description">
                            Transforming ideas into exceptional digital experiences through innovative game development, 
                            cutting-edge web solutions, and powerful applications. Let's build something extraordinary together.
                        </p>

                        <!-- Stats Counter (NEW FEATURE) -->
                        <div class="hero-stats">
                            <div class="stat-item">
                                <span class="stat-number" data-target="50">0</span>
                                <span class="stat-label">Projects</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-number" data-target="100">0</span>
                                <span class="stat-label">Happy Clients</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-number" data-target="5">0</span>
                                <span class="stat-label">Years Experience</span>
                            </div>
                        </div>

                        <!-- Call to Action Buttons -->
                        <div class="hero-actions">
                            <a href="#games" class="btn btn-primary btn-glow">
                                <i class="fas fa-gamepad"></i> 
                                <span>Explore Works</span>
                                <div class="btn-shine"></div>
                            </a>
                            <a href="#contact" class="btn btn-glass">
                                <i class="fas fa-envelope"></i> 
                                <span>Let's Talk</span>
                            </a>
                            <button class="btn btn-outline" id="watchVideoBtn">
                                <i class="fas fa-play"></i> 
                                <span>Watch Intro</span>
                            </button>
                        </div>

                        <!-- Social Links (NEW) -->
                        <div class="hero-social">
                            <span class="social-label">Follow me:</span>
                            <a href="#" class="social-link" aria-label="LinkedIn">
                                <i class="fab fa-linkedin-in"></i>
                            </a>
                            <a href="#" class="social-link" aria-label="GitHub">
                                <i class="fab fa-github"></i>
                            </a>
                            <a href="#" class="social-link" aria-label="Twitter">
                                <i class="fab fa-twitter"></i>
                            </a>
                            <a href="#" class="social-link" aria-label="Instagram">
                                <i class="fab fa-instagram"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Right Column: Visual Elements -->
                    <div class="hero-visual">
                        <!-- 3D Card Stack (NEW INNOVATIVE FEATURE) -->
                        <div class="card-stack">
                            <div class="stack-card" data-tilt>
                                <div class="card-icon">
                                    <i class="fab fa-unity"></i>
                                </div>
                                <h4>Game Development</h4>
                                <p>Immersive 3D Experiences</p>
                                <div class="card-glow"></div>
                            </div>
                            <div class="stack-card" data-tilt>
                                <div class="card-icon">
                                    <i class="fas fa-code"></i>
                                </div>
                                <h4>Web Development</h4>
                                <p>Modern Digital Solutions</p>
                                <div class="card-glow"></div>
                            </div>
                            <div class="stack-card" data-tilt>
                                <div class="card-icon">
                                    <i class="fas fa-mobile-alt"></i>
                                </div>
                                <h4>App Development</h4>
                                <p>Innovative Applications</p>
                                <div class="card-glow"></div>
                            </div>
                        </div>

                        <!-- Featured Badges (NEW) -->
                        <div class="featured-badges">
                            <div class="badge-item">
                                <i class="fas fa-award"></i>
                                <span>Top Rated</span>
                            </div>
                            <div class="badge-item">
                                <i class="fas fa-certificate"></i>
                                <span>Certified</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Scroll Indicator -->
            <div class="scroll-indicator" id="scrollIndicator">
                <span>Discover More</span>
                <i class="fas fa-chevron-down"></i>
                <div class="scroll-line"></div>
            </div>

            <!-- Background Decorations -->
            <div class="hero-decoration decoration-1"></div>
            <div class="hero-decoration decoration-2"></div>
        </section>

        <!-- ==========================================
             FEATURED BRANDS/CLIENTS MARQUEE (NEW)
             Infinite scrolling logo carousel
             ========================================== -->
        <section class="brands-marquee">
            <div class="container">
                <p class="marquee-label">Trusted by leading companies and startups</p>
            </div>
            <div class="marquee">
                <div class="marquee-content">
                    <div class="brand-item">
                        <i class="fab fa-unity"></i>
                        <span>Unity</span>
                    </div>
                    <div class="brand-item">
                        <i class="fab fa-react"></i>
                        <span>React</span>
                    </div>
                    <div class="brand-item">
                        <i class="fab fa-python"></i>
                        <span>Python</span>
                    </div>
                    <div class="brand-item">
                        <i class="fab fa-js"></i>
                        <span>JavaScript</span>
                    </div>
                    <div class="brand-item">
                        <i class="fab fa-node"></i>
                        <span>Node.js</span>
                    </div>
                    <!-- Duplicate for seamless loop -->
                    <div class="brand-item">
                        <i class="fab fa-unity"></i>
                        <span>Unity</span>
                    </div>
                    <div class="brand-item">
                        <i class="fab fa-react"></i>
                        <span>React</span>
                    </div>
                    <div class="brand-item">
                        <i class="fab fa-python"></i>
                        <span>Python</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==========================================
             ABOUT SECTION WITH TIMELINE
             - Personal story
             - Skills visualization
             - Journey timeline
             - Certifications
             ========================================== -->
        <section id="about" class="section section-about">
            <div class="container">
                <!-- Section Header -->
                <div class="section-header" data-aos="fade-up">
                    <span class="section-tag">
                        <i class="fas fa-user"></i>
                        About Me
                    </span>
                    <h2 class="section-title">Crafting Digital Excellence</h2>
                    <p class="section-description">
                        Every pixel, every line of code, every interaction tells a story
                    </p>
                </div>

                <!-- About Content Grid -->
                <div class="about-grid">
                    <!-- Left: Text Content -->
                    <div class="about-text" data-aos="fade-right">
                        <p class="lead">
                            Hi, I'm Arsh Verma – a passionate Computer Science student and creative developer who transforms 
                            innovative ideas into powerful digital realities.
                        </p>
                        <p>
                            With expertise spanning game development, modern web design, and cutting-edge applications, 
                            I bring a unique holistic approach to every project. My work isn't just about executing tasks – 
                            it's about crafting experiences that resonate, engage, and inspire.
                        </p>
                        <p>
                            I believe in the power of clean code, beautiful design, and meaningful interactions. 
                            Whether building immersive 3D games in Unity, developing responsive web applications, 
                            or creating mobile solutions that matter, I focus on delivering excellence at every touchpoint.
                        </p>

                        <!-- Quick Facts (NEW) -->
                        <div class="quick-facts">
                            <div class="fact-item">
                                <i class="fas fa-map-marker-alt"></i>
                                <div>
                                    <strong>Location</strong>
                                    <span>Ashta, Madhya Pradesh, India</span>
                                </div>
                            </div>
                            <div class="fact-item">
                                <i class="fas fa-graduation-cap"></i>
                                <div>
                                    <strong>Education</strong>
                                    <span>Computer Science Student</span>
                                </div>
                            </div>
                            <div class="fact-item">
                                <i class="fas fa-briefcase"></i>
                                <div>
                                    <strong>Experience</strong>
                                    <span>5+ Years</span>
                                </div>
                            </div>
                        </div>

                        <!-- CTA Buttons -->
                        <div class="about-actions">
                            <a href="#contact" class="btn btn-primary">
                                <i class="fas fa-paper-plane"></i>
                                Get In Touch
                            </a>
                            <a href="#" class="btn btn-glass" id="downloadCVBtn">
                                <i class="fas fa-download"></i>
                                Download CV
                            </a>
                        </div>
                    </div>

                    <!-- Right: Skills & Experience -->
                    <div class="about-visual" data-aos="fade-left">
                        <!-- Skills Radar Chart (NEW FEATURE) -->
                        <div class="skills-radar">
                            <canvas id="skillsChart"></canvas>
                        </div>

                        <!-- Experience Timeline (NEW) -->
                        <div class="experience-timeline">
                            <h3>My Journey</h3>
                            <div class="timeline">
                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>
                                    <div class="timeline-content">
                                        <span class="timeline-year">2024</span>
                                        <h4>Senior Developer</h4>
                                        <p>Leading innovative projects</p>
                                    </div>
                                </div>
                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>
                                    <div class="timeline-content">
                                        <span class="timeline-year">2022</span>
                                        <h4>Full Stack Developer</h4>
                                        <p>Building scalable solutions</p>
                                    </div>
                                </div>
                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>
                                    <div class="timeline-content">
                                        <span class="timeline-year">2020</span>
                                        <h4>Started Journey</h4>
                                        <p>First lines of code</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CONTINUE IN NEXT MESSAGE DUE TO LENGTH... -->

    </main>

